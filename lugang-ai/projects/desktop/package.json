{
  "name": "@lugang/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "鲁港通 Windows 桌面客户端（P1）",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "prebuild": "node node_modules/electron/install.js",
    "build": "node build.mjs",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cd ../.. && vitest run --config vitest.simple.config.mts projects/desktop",
    "dist": "pnpm build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/adm-zip": "catalog:",
    "@types/node": "catalog:",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "esbuild": "^0.25.11",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "build": {
    "appId": "com.airscend.lugang",
    "productName": "鲁港通",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "鲁港通"
    },
    "artifactName": "lugang-desktop-${version}-setup.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://www.airscend.com/desktop/updates/"
      }
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "catalog:",
    "@xmldom/xmldom": "catalog:",
    "adm-zip": "catalog:",
    "docx": "catalog:",
    "exceljs": "catalog:",
    "pdf-lib": "catalog:"
  }
}
