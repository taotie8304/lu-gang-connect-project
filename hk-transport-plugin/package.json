{
  "name": "fastgpt-tools-hk-transport-assistant",
  "version": "1.0.0",
  "description": "香港智能交通助手 - FastGPT 系统插件",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx @fastgpt-plugin/cli build --minify",
    "build:dev": "npx @fastgpt-plugin/cli build",
    "check": "npx @fastgpt-plugin/cli check --entry . --output ./dist",
    "debug": "npx @fastgpt-plugin/cli debug .",
    "pack": "npx @fastgpt-plugin/cli pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "fastgpt",
    "plugin",
    "hong-kong",
    "transport"
  ],
  "author": "鲁港通 (Lugang Connect)",
  "license": "MIT",
  "devDependencies": {
    "@fastgpt-plugin/cli": "^0.2.1",
    "@fastgpt-plugin/sdk-factory": "^1.1.0",
    "@vitest/coverage-v8": "^3.1.2",
    "fast-check": "^3.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "zod": "^4"
  }
}
