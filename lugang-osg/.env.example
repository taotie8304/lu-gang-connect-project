# 鲁港通 - OSG 环境变量模板（复制为 .env 后填写，.env 永不提交）
# 数据库：生产 PG 容器经 172.17.0.1 访问；本地开发用 localhost
OSG_DATABASE_URL=postgresql+psycopg2://postgres:你的密码@127.0.0.1:5432/lugang_osg
OSG_REDIS_URL=redis://127.0.0.1:6379/3

# 鲁港通 - 双 API Key（FastGPT 调用侧 / 管理后台侧，务必用 openssl rand -hex 32 生成不同值）
OSG_API_KEY_FASTGPT=请生成随机密钥
OSG_API_KEY_ADMIN=请生成随机密钥

# 可选
OSG_DEBUG=false
